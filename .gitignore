__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Dati scaricati/generati: probabilmente troppo pesanti/volatili per Git
data/raw_html/*
!data/raw_html/.gitkeep

# Il Gold Standard invece SI versiona (è lavoro manuale, va protetto)
# -> nessuna esclusione su gs_data/

# Volumi Docker: la persistenza reale usa named volumes, non queste
# cartelle (tenute solo per rispettare la struttura di consegna richiesta)
mariadb_data/*
!mariadb_data/.gitkeep
ollama_data/*
!ollama_data/.gitkeep

.env
.DS_Store
**/.DS_Store

report/report.aux
report/report.log
report/report.out
